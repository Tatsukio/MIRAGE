<Window x:Class="ParaWorldStatus.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/icon.ico"
        Title="ParaWorld Status" Height="294" Width="272" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        WindowStyle="ToolWindow" WindowState="Minimized">
    <!-- DataContext: ViewModels.MainViewModel, set in App.xaml.cs. -->
    <Grid Width="256" Height="256">
        <Grid.Background>
            <ImageBrush ImageSource="/icon.ico"/>
        </Grid.Background>
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Update status" Command="{Binding RefreshCommand}"/>
                <MenuItem Header="Exit" Command="{Binding ExitCommand}"/>
            </ContextMenu>
        </Grid.ContextMenu>
        <Border VerticalAlignment="Bottom" Background="#B0000000" Padding="6,3">
            <StackPanel>
                <TextBlock Text="{Binding ConnectionText}" Foreground="White" FontSize="11"/>
                <TextBlock Text="{Binding PresenceText}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
