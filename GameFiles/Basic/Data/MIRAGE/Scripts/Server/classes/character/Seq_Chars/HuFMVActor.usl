/*?
	?group URS.Scripts.Server.Classes.CCharacter
	?item CHuFMVActor
	?desc class for sequence actors in game
	?prefix CHuFMVActor
?*/
class CHuFMVActor inherit CHu

	export constructor()
	endconstructor;

	export destructor()
	enddestructor;

	/*?
		?item FilmAction(^CGameObj, vec3, string )
		?desc Is called, when a film action is started by the user.
		?param string the kind of film action which is requested
	?*/

	proc void FilmAction(^CGameObj p_pxObject, vec3 p_vPos, string p_sMiscParams)
		if(p_sMiscParams == "escape_from_hudorf")then
			var vec3 vShift;
			vShift.SetX((Random.GetInt() % 780).ToReal() / 10.0);
			vShift.SetY((Random.GetInt() % 440).ToReal() / 10.0);
//			Windows.DbgPrint(vShift.ToString());
			WalkAction({1693.0,1218.0,28.50} + vShift,2,true);
		endif;
	endproc;

    /*
        called when a gameplay command for this character is received
    */
	export proc void HandleGamePlayCommand(string p_sCommand, ^CGameObj p_pxObject, vec3 p_vPos, string p_sMiscParams)
		super.HandleGamePlayCommand(p_sCommand, p_pxObject, p_vPos, p_sMiscParams);
		if(p_sCommand == "filmaction")then
			FilmAction(p_pxObject, p_vPos, p_sMiscParams);
		endif;
	endproc;

endclass;
