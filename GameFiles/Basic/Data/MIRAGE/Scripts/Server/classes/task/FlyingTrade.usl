// NOT USED ANYMORE
class CFlyingTrade inherit CTask

	var CObjHndl	m_xWorker;
	var CObjHndl	m_xCurrentWarehouse;
	var CGameTime	m_xLastTick;
	var string		m_sState;
	var vec3		m_vCurTarget;
	var bool		m_bLastWarehouse;
	var bool		m_bNoWarehouse;

	const real	LOW_HEIGHT = 15.0f;
	const real	FLYING_HEIGHT = 30.0f;
	const real	SPAWN_HEIGHT = 100.0f;

	export constructor()
		SetName("FlyTra");
	endconstructor;

	export proc void Save(^CUOFWriterNode p_pxWriterNode)
		super.Save(p_pxWriterNode);
		var CFourCC xType = "FlTr";
		var ^CUOFWriterNode pxWalk = p_pxWriterNode^.AddSubChunk(xType,2);
		var ^CArc pxArc = ^(pxWalk^.GetArc());
		m_xWorker.DoKArc(pxArc^);
		m_xCurrentWarehouse.DoKArc(pxArc^);
		m_xLastTick.DoKArc(pxArc^);
		(pxArc^) << m_sState;
		(pxArc^) << m_vCurTarget;
		(pxArc^) << m_bLastWarehouse;
		(pxArc^) << m_bNoWarehouse;
		pxWalk^.Close();
	endproc;

	export proc void Load(^CUOFReaderNode p_pxReaderNode)
		if (p_pxReaderNode^.GetType() == "FlTr") then
			var ^CArc pxArc = ^(p_pxReaderNode^.GetArc());
			m_xWorker.DoKArc(pxArc^);
			m_xCurrentWarehouse.DoKArc(pxArc^);
			m_xLastTick.DoKArc(pxArc^);
			(pxArc^) << m_sState;
			(pxArc^) << m_vCurTarget;
			(pxArc^) << m_bLastWarehouse;
			if (p_pxReaderNode^.GetVersion() >= 2) then
				(pxArc^) << m_bNoWarehouse;
			endif;
		else
			super.Load(p_pxReaderNode);
		endif;
	endproc;

	export proc void Init(CObjHndl p_xWorker, vec3 p_vDest)
		//L KLog.LogSpam("FlyingTrade","Enter Init()");

		m_xWorker = p_xWorker;

		var ^CGameObj pxWorker = m_xWorker.GetObj();
		if (pxWorker == null) then EndTask(); return; endif;
		if ((cast<CFlyingTrader>(pxWorker)) == null) then EndTask(); return; endif;
		var ^CAttribs pxAttr = pxWorker^.GetAttribs();
		if (pxAttr != null) then
			pxAttr^.SetValue("CurTask",GetName());
		endif;
		m_vCurTarget = p_vDest;
		m_bNoWarehouse = true;
		m_sState = "lower_to_path";
	endproc;

	export proc void Init(CObjHndl p_xWorker, CObjHndl p_xWarehouse, bool p_bNewOwner, bool p_bLastWarehouse)
		//L KLog.LogSpam("FlyingTrade","Enter Init()");

		m_xWorker = p_xWorker;
		m_xCurrentWarehouse = p_xWarehouse;

		if (p_bNewOwner) then
			m_sState = "lower_to_path";
		else
			m_sState = "goto_warehouse";
		endif;

		m_bLastWarehouse = p_bLastWarehouse;

		var ^CGameObj pxWorker = m_xWorker.GetObj();
		if (pxWorker == null) then EndTask(); return; endif;
		if ((cast<CFlyingTrader>(pxWorker)) == null) then EndTask(); return; endif;
		var ^CAttribs pxAttr = pxWorker^.GetAttribs();
		if (pxAttr != null) then
			pxAttr^.SetValue("CurTask",GetName());
		endif;

		if (m_xCurrentWarehouse.GetObj() == null) then EndTask(); return; endif;
		m_bNoWarehouse = false;
	endproc;

	proc void USLOnEnter(^CState p_pxFrom, ^CState p_pxTo)
		//L CSrvWrap.LogSpam("FlyingTrade","USLOnEnter()");
		var ^CGameObj pxWorker = m_xWorker.GetObj();
		if (pxWorker == null) then EndTask();return; endif;
		if ((cast<CFlyingTrader>(pxWorker)) == null) then EndTask(); return; endif;

		if (!m_bNoWarehouse) then
			if (m_xCurrentWarehouse.GetObj() == null) then EndTask(); return; endif;
		endif;
	endproc;

	proc void USLOnTick(int p_iTime)
		//L CSrvWrap.LogSpam("FlyingTrade","USLOnTick()");

		var ^CGameObj pxWorker = m_xWorker.GetObj();
		if (pxWorker == null) then EndTask(); return; endif;
		var ^CFlyingTrader pxTrader = cast<CFlyingTrader>(pxWorker);
		if (pxTrader == null) then EndTask(); return; endif;

		var ^CGameObj pxWarehouse;
		if (!m_bNoWarehouse) then
			pxWarehouse = m_xCurrentWarehouse.GetObj();
			if (pxWarehouse == null) then EndTask(); return; endif;
		endif;

		//L CSrvWrap.LogSpam("FlyingTrade","MyPos:"+pxTrader^.GetPos().ToString());
		//L CSrvWrap.LogSpam("FlyingTrade","state: "+m_sState);


		if (m_sState == "lower_to_path") then
			if (!m_bNoWarehouse) then
				m_vCurTarget = pxWarehouse^.GetPos();
			endif;

			var vec3 vPos = m_vCurTarget;
			var vec3 vDistance = {80.0, 0.0, 0.0};
			var Quat qRot;
			qRot.SetIdentity();
			qRot.RotateZ( Random.MTRandF(0.0, Math.Pi() * 2.0) );
			qRot.VecRotateU(vDistance);

			vPos += vDistance;
			vPos.SetZ( SPAWN_HEIGHT );
			pxWorker^.SetPos(vPos);

			vPos.SetZ( m_vCurTarget.GetZ() + FLYING_HEIGHT );
			pxWorker^.MoveAction(vPos, 6.0);
			m_sState = "goto_warehouse";

		elseif (m_sState == "goto_warehouse") then
			if (!m_bNoWarehouse) then
				m_vCurTarget = pxWarehouse^.GetPos();
			endif;

			var vec3 vPos = m_vCurTarget;
			vPos.SetZ( m_vCurTarget.GetZ() + FLYING_HEIGHT );
			pxWorker^.WalkAction(vPos, 4, false, false);
//			pxWorker^.MoveAnimAction(vPos, 4.0f, Math.Pi()*0.5, "walk_4");
			m_sState = "moving_to_warehouse";

		elseif (m_sState == "moving_to_warehouse") then
			if ((pxWorker^.GetPos() - m_vCurTarget).Abs() <= 60.0) then
				m_sState = "lower_craft";
			else
				m_sState = "goto_warehouse";
			endif;

		elseif (m_sState == "lower_craft") then

			if (!m_bNoWarehouse) then
				var ^CWarehouse pxWH = cast<CWarehouse>(pxWarehouse);
				if (pxWH != null) then
					pxWH^.AcceptTrader();
				endif;
			endif;

			var vec3 vPos = m_vCurTarget;
			vPos.SetZ( m_vCurTarget.GetZ() + LOW_HEIGHT );
			pxWorker^.MoveAction(vPos, 6.0);
			m_sState = "trade";

		elseif (m_sState == "trade") then

			if (m_bNoWarehouse) then
				EndTask();
				return;
			endif;

			pxTrader^.WarehouseVisited();
			m_xLastTick = CTimeMgr.Get().GetTime();
			m_sState = "hangaround";
			pxWorker^.SetAnim("standanim",3);

		elseif (m_sState == "hangaround") then

			var CGameTime xNow = CTimeMgr.Get().GetTime();
			if ( (xNow - m_xLastTick).GetSecondsF() > 3.0) then   //wait a bit here...
				m_sState = "raise_craft";
			endif;

		elseif (m_sState == "raise_craft") then
			var vec3 vPos = m_vCurTarget;
			vPos.SetZ( m_vCurTarget.GetZ() + FLYING_HEIGHT );
			pxWorker^.MoveAction(vPos, 6.0);

			if (m_bLastWarehouse) then
				m_sState = "go_away";
			else
				m_sState = "end";
			endif;

		elseif (m_sState == "go_away") then
			var vec3 vPos = pxWarehouse^.GetPos();
			var vec3 vDistance = {80.0, 0.0, 0.0};
			var Quat qRot;
			qRot.SetIdentity();
			qRot.RotateZ( Random.MTRandF(0.0, Math.Pi() * 2.0) );
			qRot.VecRotateU(vDistance);
			vPos += vDistance;
			vPos.SetZ( m_vCurTarget.GetZ() + FLYING_HEIGHT );
			pxWorker^.WalkAction(vPos, 4, false, false);
			//pxWorker^.MoveAnimAction(vPos, 4.0f, Math.Pi()*0.5, "walk_4");
			m_sState = "go_to_sky";

		elseif (m_sState == "go_to_sky") then
			var vec3 vPos = pxWorker^.GetPos();
			vPos.SetZ( SPAWN_HEIGHT );
			pxWorker^.MoveAction(vPos, 6.0);
			m_sState = "end";

		elseif (m_sState == "end") then
			EndTask();

		else
			//L CSrvWrap.LogWarning("FlyingTrade","invalid state: "+m_sState);
			EndTask();
		endif;
	endproc;

	proc void USLOnLeave(^CState p_pxFrom, ^CState p_pxTo)
		//L CSrvWrap.LogSpam("FlyingTrade","USLOnLeave()");
	endproc;

	export proc bool Break()
		var ^CGameObj pxWorker = m_xWorker.GetObj();
		if (pxWorker != null) then pxWorker^.TerminateAction(); endif;
		return true;
	endproc;

endclass;
