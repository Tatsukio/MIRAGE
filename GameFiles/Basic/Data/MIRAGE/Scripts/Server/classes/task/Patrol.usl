//unused class
class CPatrol inherit CTask

	var CObjHndl	m_xObj;
	var int			m_iCurWaypoint;
	var bool		m_bCircular;
	var bool		m_bForward;
	var int			m_iSpeed;
	var bool		m_bUseMaterial;
	var array vec3	m_avWaypoints;
	var bool		m_bStrict;

	export constructor()
		SetName("Patrol");
		SetCivil(false);
	endconstructor;

	export proc void Save(^CUOFWriterNode p_pxWriterNode)
		super.Save(p_pxWriterNode);
		var CFourCC xType = "Ptrl";
		var ^CUOFWriterNode pxWalk = p_pxWriterNode^.AddSubChunk(xType,2);
		var ^CArc pxArc = ^(pxWalk^.GetArc());
		m_xObj.DoKArc(pxArc^);
		(pxArc^) << m_iCurWaypoint;
		(pxArc^) << m_bCircular;
		(pxArc^) << m_bForward;
		(pxArc^) << m_iSpeed;
		(pxArc^) << m_bUseMaterial;
		(pxArc^) << m_bStrict;

		var int i,iC = m_avWaypoints.NumEntries();
		(pxArc^) << iC;
		for(i = 0) cond(i < iC) iter(i++) do
			(pxArc^) << m_avWaypoints[i];
		endfor;

		pxWalk^.Close();
	endproc;

	export proc void Load(^CUOFReaderNode p_pxReaderNode)
		if(p_pxReaderNode^.GetType() == "Ptrl")then
			var ^CArc pxArc = ^(p_pxReaderNode^.GetArc());
			m_xObj.DoKArc(pxArc^);
			(pxArc^) << m_iCurWaypoint;
			(pxArc^) << m_bCircular;
			(pxArc^) << m_bForward;
			(pxArc^) << m_iSpeed;
			(pxArc^) << m_bUseMaterial;
			if(p_pxReaderNode^.GetVersion() >= 2) then
				(pxArc^) << m_bStrict;
			endif;

			var int i,iC;
			(pxArc^) << iC;
			m_avWaypoints = iC;
			for(i = 0) cond(i < iC) iter(i++) do
				(pxArc^) << m_avWaypoints[i];
			endfor;
		else
			super.Load(p_pxReaderNode);
		endif;
	endproc;
