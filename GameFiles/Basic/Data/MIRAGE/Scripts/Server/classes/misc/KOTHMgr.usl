class CSimpleKOTHSector inherit CGameObj

	export proc void OnInit(bool p_bLoad)
		if(!p_bLoad) then
			SetType("KOTS");
		endif;
		InitEvents();	
		InitAttribs();
		
		var ^CAttribs pxA = GetAttribs();
		if(pxA!=null) then
			pxA^.SetValue("controlling_team", -1);
		endif;
	endproc;
	
	export proc void Load(^CUOFReaderNode p_pxReaderNode)
		super.Load(p_pxReaderNode);
	endproc;

	export proc void Save(^CUOFWriterNode p_pxWriterNode)
		super.Save(p_pxWriterNode);
	endproc;
	
endclass;

class CKOTHSector inherit CGameObj

	const int STATE_UNDER_CONTROL	= 0;
	const int STATE_LOOSING_CONTROL = 1;
	const int STATE_GAINING_CONTROL = 2;

	const int GAIN_CONTROL_TIMER_ID 	= 1234;
	const int LOOSE_CONTROL_TIMER_ID 	= 1235;
	
	const real GAIN_CONTROL_DELAY 		= 15.0f;
	const real LOOSE_CONTROL_DELAY 		= 15.0f;

	var int m_iTeam;	
	var CGuid m_xRgnGuid;
	var int m_iState;
	var int m_iGainCtrlTeam;
	var CObjHndl m_xFlag;
	
	var CRegionSink m_xSink;
	
	var array int m_aiTeamOwner;
	var array int m_aiEnemyOwner;
	
	static var array int ms_aiTeamLookUp;
		
	export var procref <void, CObjHndl, int> m_xOnControllerChanged;

	export constructor()
		m_iTeam = -1;
		m_iState = STATE_UNDER_CONTROL;
		m_iGainCtrlTeam = -1;
	endconstructor;

	export proc void OnInit(bool p_bLoad)
		if(!p_bLoad) then
			SetType("KOTS");
			var ^CGameObj pxO = CSrvWrap.GetObjMgr()^.CreateObj("all_capture_flag", -1);
			pxO^.SetSelectable(false);
			m_xFlag = pxO^.GetHandle();
		endif;
		InitEvents();	
		InitAttribs();
		
		var ^CAttribs pxA = GetAttribs();
		if(pxA!=null) then
			pxA^.SetValue("controlling_team", -1);
		endif;
	endproc;
	
	export proc void Delete()
		if(m_xFlag.IsValid()) then
			m_xFlag.GetObj()^.Delete();
		endif;
	endproc;
	
	export proc void Init(CGuid p_xRgnGuid)
		m_xRgnGuid = p_xRgnGuid;
		m_xSink.SetRegion(CSrvWrap.GetRegionMgr().GetRegionByGuid(m_xRgnGuid));
		m_xSink.m_xOnChange=OnChange;
		m_xSink.Subscribe();
		
		if(ms_aiTeamLookUp.NumEntries()==0) then
			ms_aiTeamLookUp=8;
			var ^CLevel pxLevel=CSrvWrap.GetCurLevel();
			if(pxLevel!=null) then
				var int i;
				for(i=0) cond(i<8) iter(i++) do
					var ^CPlayer pxPlayer=pxLevel^.GetPlayer(i);
					if(pxPlayer!=null) then
						ms_aiTeamLookUp[pxPlayer^.GetID()] = pxPlayer^.GetTeamID();
					endif;
				endfor;
			endif;
		endif;
		
		var ^CRegion pxRegion=m_xSink.GetRegion();
		var vec3 vPos = pxRegion^.GetPos();
		vPos.SetZ(CSrvWrap.GetScapeMgr().GetHeight(vPos.GetX(), vPos.GetY()));
		if(m_xFlag.IsValid()) then
			m_xFlag.GetObj()^.SetPos(vPos);
		endif;
		
		var vec3 vP = pxRegion^.GetPos();
		var real fR = pxRegion^.GetRadius();
		
		var ^CAttribs pxA = GetAttribs();
		if(pxA!=null) then
			pxA^.SetValue("rgn_pos", vP.ToString());
			pxA^.SetValue("rgn_radius", fR);
			
//			KLog.LogSpam("MaZi", "RegionPos : "+vP.ToString());
//			KLog.LogSpam("MaZi", "RegionRad : "+fR.ToString());
		endif;
	endproc;
	
	export static proc int GetTeam(int p_iOwner)
		if(p_iOwner==-1) then
			return -1;
		endif;
		return ms_aiTeamLookUp[p_iOwner];
	endproc;
	
	export proc bool OnChange()
		//L KLog.LogSpam("MaZi", "OnChange ...");
		var CObjQuery xQ;
		xQ.SetRegion(m_xSink.GetRegion()^.GetHandle());
		xQ.SetType("CHTR", false);
		xQ.SetType("VHCL", true);
		xQ.SetType("ANML", true);
		xQ.SetType("SHIP", true);
		
		if(m_iTeam>=0) then
			//L KLog.LogSpam("MaZi", "controlled sector");
			var int i,iC = m_aiTeamOwner.NumEntries();
			for(i=0) cond(i<iC) iter(++i) do
				xQ.SetOwner(m_aiTeamOwner[i], i!=0);
			endfor;
			
			var CObjList xL;
			xQ.Execute(xL);
			
			//L KLog.LogSpam("MaZi", "Num Objs: "+xL.NumEntries().ToString());			
			if(xL.NumEntries()>0) then 
				if(m_iState==STATE_LOOSING_CONTROL) then
					DeleteTimer(LOOSE_CONTROL_TIMER_ID);
					m_iState = STATE_UNDER_CONTROL;
					//L KLog.LogSpam("MaZi", "loosing state deleted");
				endif;
				return true;
			endif;
			if(m_iState != STATE_LOOSING_CONTROL) then
				m_iState = STATE_LOOSING_CONTROL;
				//L KLog.LogSpam("MaZi", "loosing state");
				CreateTimer(LOOSE_CONTROL_TIMER_ID, CGameTimeSpan.OneSecond() * LOOSE_CONTROL_DELAY, false);
			endif;
		else
			//L KLog.LogSpam("MaZi", "neutral sector");
			if(m_iState!=STATE_GAINING_CONTROL) then
				var int i,iC = m_aiEnemyOwner.NumEntries();
				for(i=0) cond(i<iC) iter(++i) do
					xQ.SetOwner(m_aiEnemyOwner[i], i!=0);
				endfor;
				
				var CObjList xL;
				xQ.Execute(xL);
								
				var int iDominator = -1;
				iC = xL.NumEntries();
				for(i=0) cond(i<iC) iter(++i) do
					var ^CGameObj pxO = xL[i].GetObj();
					if(pxO!=null) then
						var int iT = GetTeam(pxO^.GetOwner());
						if(iDominator>=0 && iT!=iDominator) then
							return false;
						elseif(iT>=0 && iDominator<0) then
							iDominator = iT;
						endif;
					endif;
				endfor;
				
				//L KLog.LogSpam("MaZi", "iDominator = "+iDominator.ToString());
				
				if(m_iGainCtrlTeam != iDominator) then
					m_iGainCtrlTeam = iDominator;
					
					CreateTimer(GAIN_CONTROL_TIMER_ID, CGameTimeSpan.OneSecond()*GAIN_CONTROL_DELAY, false);
					//L KLog.LogSpam("MaZi", "gaining control ...");
					m_iState = STATE_GAINING_CONTROL;
				endif;
			else
				var array int aiEnemies;
				var ^CLevel pxLevel=CSrvWrap.GetCurLevel();
				if(pxLevel!=null) then
					var int i;
					for(i=0) cond(i<8) iter(i++) do
						var ^CPlayer pxPlayer=pxLevel^.GetPlayer(i);
						if(pxPlayer!=null) then
							if(pxPlayer^.GetTeamID()!=m_iGainCtrlTeam) then
								aiEnemies.AddEntry(pxPlayer^.GetID());
							endif;
						endif;
					endfor;
				endif;
				
				var int i, iC = aiEnemies.NumEntries();
				for(i=0) cond(i<iC) iter(++i) do
					xQ.SetOwner(aiEnemies[i], i!=0);
				endfor;
				var CObjList xL;
				xQ.Execute(xL);
								
				if(xL.NumEntries()>0) then
					m_iState=STATE_UNDER_CONTROL;
					DeleteTimer(GAIN_CONTROL_TIMER_ID);
					//L KLog.LogSpam("MaZi", "gaining controll stoped ...");
				endif;
			endif;
		endif;
		return true;
	endproc;
	
	proc void HandleEvent(ref CGameEvtPtr p_rxEvtPtr)
		if (p_rxEvtPtr.GetClass() == ms_xTimerClass) then
			if (p_rxEvtPtr.GetInt(0) == LOOSE_CONTROL_TIMER_ID) then
				//L KLog.LogSpam("MaZi", "loose ctrl");
				SetOwningTeam(-1);
			elseif (p_rxEvtPtr.GetInt(0) == GAIN_CONTROL_TIMER_ID) then
				SetOwningTeam(m_iGainCtrlTeam);
				//L KLog.LogSpam("MaZi", "gain ctrl");
			endif;
		endif;
	endproc;
	
	export proc void Load(^CUOFReaderNode p_pxReaderNode)
		if(p_pxReaderNode^.GetType()=="khse")then
			var ^CArc pxArc=^(p_pxReaderNode^.GetArc());
			m_xFlag.DoKArc(pxArc^);
			pxArc^ << m_iTeam;
			SetOwningTeam(m_iTeam);
			pxArc^ << m_iState;
			pxArc^ << m_xRgnGuid;
			pxArc^ << m_iGainCtrlTeam;
			Init(m_xRgnGuid);
		else
			super.Load(p_pxReaderNode);
		endif;
	endproc;

	export proc void Save(^CUOFWriterNode p_pxWriterNode)
		super.Save(p_pxWriterNode);
		var CFourCC xBase="khse"; 
		var ^CUOFWriterNode pxWalk=p_pxWriterNode^.AddSubChunk(xBase,0);
		var ^CArc pxArc=^(pxWalk^.GetArc());
		m_xFlag.DoKArc(pxArc^);
		pxArc^ << m_iTeam;
		pxArc^ << m_iState;
		pxArc^ << m_xRgnGuid;
		pxArc^ << m_iGainCtrlTeam;		
		pxWalk^.Close();
	endproc;
	
	export proc void OnPostLoad()
		CKOTHMgr.Get().AddSector(GetHandle());
	endproc;
	
	export proc void SetOwningTeam(int p_iTeam)
		m_iTeam = p_iTeam;
		m_aiTeamOwner = 0;
		m_aiEnemyOwner = 0;
		
		var ^CLevel pxLevel=CSrvWrap.GetCurLevel();
		if(pxLevel!=null) then
			var int i;
			for(i=0) cond(i<8) iter(i++) do
				var ^CPlayer pxPlayer=pxLevel^.GetPlayer(i);
				if(pxPlayer!=null) then
					if(pxPlayer^.GetTeamID()==p_iTeam && p_iTeam>=0) then
						m_aiTeamOwner.AddEntry(pxPlayer^.GetID());
					else
						m_aiEnemyOwner.AddEntry(pxPlayer^.GetID());
					endif;
				endif;
			endfor;
		endif;
		
		var int iOwner = -1;
		if(m_aiTeamOwner.NumEntries()>0) then
			iOwner = m_aiTeamOwner[0];
		endif;
		var ^CGameObj pxFlag = m_xFlag.GetObj();
		if(pxFlag!=null) then
			pxFlag^.SetOwner(iOwner);
		endif;
		
		m_iState = STATE_UNDER_CONTROL;
		m_iGainCtrlTeam=-1;
		
		CSrvWrap.SendGenericEvtToClients(0ffh, "MiniMapEvent\t"+m_xSink.GetRegion()^.GetPos().ToString()+"\tAttack");
		if(!m_xOnControllerChanged.IsNull()) then
			m_xOnControllerChanged.Call(GetHandle(), m_iTeam);
		endif;
		
		var ^CAttribs pxA = GetAttribs();
		if(pxA!=null) then
			pxA^.SetValue("controlling_team", m_iTeam);
		endif;
	endproc;
	
	export proc int GetOwningTeam()
		return m_iTeam;
	endproc;
	
	export proc array int GetOwningTeamOwners()
		return m_aiTeamOwner;
	endproc;
endclass;

class CKOTHTimer inherit CGameObj
	
	const int TIMER_ID = 1;
	
	var real 		m_fMaxDuration;
	var real		m_fCurDuration;
	var CGameTime 	m_xStart;
	
	export var procref<void> m_xOnFire;
		
	export proc void OnInit(bool p_bLoad) 
		InitEvents();
		if(!p_bLoad) then
			SetType("KHTI");
		endif;
		
		m_fMaxDuration = 0.0f;
		m_fCurDuration = 0.0f;
		m_xStart = CGameTime.GetInvalidTime();
		CSrvWrap.SendGenericEvtToClients(0ffh, "Counter\tSetNoHide\ttrue");
	endproc;
	
	export proc void OnPostLoad()
		CKOTHMgr.Get().SetTimerHandle(GetHandle());
	endproc;
	
	export proc void SetMaxTime(real p_fMax)
		m_fCurDuration = m_fMaxDuration = p_fMax;
		Reset();
	endproc;
	
	export proc void Start()
		if(m_xStart == CGameTime.GetInvalidTime()) then
			m_fCurDuration = m_fMaxDuration;
		endif;
		m_xStart = CTimeMgr.Get().GetTime();
		
		DeleteTimer(TIMER_ID);
		CreateTimer(TIMER_ID, CGameTimeSpan.OneSecond()*m_fCurDuration, false);
		CSrvWrap.SendGenericEvtToClients(0ffh, "Counter\tStart\t"+m_xStart.ToString()+"\t"+m_fMaxDuration.ToString()+"\t"+m_fCurDuration.ToString()+"\tfalse");
	endproc;
	
	export proc void Stop()
		DeleteTimer(TIMER_ID);
		var CGameTime xNow = CTimeMgr.Get().GetTime();
		var real fPassedTime = (xNow-m_xStart).GetSecondsF();
		m_fCurDuration = m_fCurDuration - fPassedTime;
		CSrvWrap.SendGenericEvtToClients(0ffh, "Counter\tStop");
	endproc;
	
	export proc void Reset()
		DeleteTimer(TIMER_ID);
		m_fCurDuration = m_fMaxDuration;
		m_xStart = CGameTime.GetInvalidTime();
		CSrvWrap.SendGenericEvtToClients(0ffh, "Counter\tStart\t"+CTimeMgr.Get().GetTime().ToString()+"\t"+m_fMaxDuration.ToString()+"\t"+m_fCurDuration.ToString()+"\tfalse\ttrue");
	endproc;
	
	proc void HandleEvent(ref CGameEvtPtr p_rxEvtPtr)
		if (p_rxEvtPtr.GetClass() == ms_xTimerClass) then
			if (p_rxEvtPtr.GetInt(0) == TIMER_ID) then
				if(!m_xOnFire.IsNull()) then
					m_xOnFire.Call();
				endif;
			endif;
		endif;
	endproc;
	
	export proc void Load(^CUOFReaderNode p_pxReaderNode)
		if(p_pxReaderNode^.GetType()=="khti")then
			var ^CArc pxArc=^(p_pxReaderNode^.GetArc());
			pxArc^ << m_fMaxDuration;
			pxArc^ << m_fCurDuration;
			m_xStart.DoKArc(pxArc^);
		else
			super.Load(p_pxReaderNode);
		endif;
	endproc;

	export proc void Save(^CUOFWriterNode p_pxWriterNode)
		super.Save(p_pxWriterNode);
		var CFourCC xBase="khti"; 
		var ^CUOFWriterNode pxWalk=p_pxWriterNode^.AddSubChunk(xBase,0);
		var ^CArc pxArc=^(pxWalk^.GetArc());
		
		pxArc^ << m_fMaxDuration;
		pxArc^ << m_fCurDuration;
		m_xStart.DoKArc(pxArc^);
		
		pxWalk^.Close();
	endproc;
endclass;

class CKOTHMgr

	var int m_iLastDominator;
	var int m_iCurDominator;
	

	static var ^CKOTHMgr ms_pxInst;
	
	export static proc ref CKOTHMgr Get()
		if(ms_pxInst==null) then ms_pxInst = new CKOTHMgr(); endif;
		return ms_pxInst^;
	endproc;

	var CObjList m_xSectors;
	var CObjHndl m_xTimer;
	
	export constructor()
		m_iLastDominator = -1;
		m_iCurDominator = -1;
	endconstructor;
	
	export proc void Clear()
		var int i, iC = m_xSectors.NumEntries();
		for(i=0) cond(i<iC) iter(++i) do
			if(m_xSectors[i].IsValid()) then
				m_xSectors[i].GetObj()^.Delete();
			endif;
		endfor;
		m_xSectors.Clear();
	endproc;
	
	export proc void CreateSector(CGuid p_xRgnGuid)
		var ^CKOTHSector pxSector = cast<CKOTHSector>(CSrvWrap.GetObjMgr()^.CreateObj("koth_sector", -1));
		if(pxSector!=null) then
			pxSector^.Init(p_xRgnGuid);
			pxSector^.m_xOnControllerChanged = OnSectorControllerChanged;
			m_xSectors.Include(pxSector^.GetHandle());
		endif;
	endproc;
	
	export proc void AddSector(CObjHndl p_xSector)
		if(p_xSector.IsValid()) then
			var ^CKOTHSector pxSector = cast<CKOTHSector>(p_xSector.GetObj());
			if(pxSector!=null) then
				m_xSectors.Include(p_xSector);
				pxSector^.m_xOnControllerChanged = OnSectorControllerChanged;
			endif;
		endif;
	endproc;
	
	export proc void CreateTimerHandle(real p_fDuration)
		//L KLog.LogSpam("MaZi", "CreateTimerHandle");
		var ^CKOTHTimer pxTimer = cast<CKOTHTimer>(CSrvWrap.GetObjMgr()^.CreateObj("koth_timer", -1));
		if(pxTimer!=null) then
			//L KLog.LogSpam("MaZi", " ... duration = "+p_fDuration.ToString());
			pxTimer^.SetMaxTime(p_fDuration);
			m_xTimer = pxTimer^.GetHandle();
			pxTimer^.m_xOnFire = OnTimerFire;
		endif;
	endproc;
	
	export proc void SetTimerHandle(CObjHndl p_xTimer)
		if(p_xTimer.IsValid()) then
			var ^CKOTHTimer pxTimer = cast<CKOTHTimer>(p_xTimer.GetObj());
			if(pxTimer!=null) then
				m_xTimer = p_xTimer;				
				pxTimer^.m_xOnFire = OnTimerFire;
			endif;
		endif;
	endproc;
	
	proc void OnTimerFire()
		var int iWinningTeam = m_iCurDominator;
		
		var ^CLevel pxLevel=CSrvWrap.GetCurLevel();
		if(pxLevel!=null) then
			var string sSend = "GameOver";
			
			var int i;
			for(i=0) cond(i<8) iter(i++) do
				var ^CPlayer pxPlayer=pxLevel^.GetPlayer(i);
				if(pxPlayer!=null) then
					if(pxPlayer^.GetTeamID()==iWinningTeam) then
						CSrvWrap.SendGenericEvtToPlayer(i, sSend+"\tMultiplayer\tWin");
					else
						CSrvWrap.SendGenericEvtToPlayer(i, sSend+"\tMultiplayer\tLose");
					endif;
				endif;
			endfor;
		endif;
	endproc;	
		
	proc void OnSectorControllerChanged(CObjHndl p_xSector, int p_iTeam)
		//L KLog.LogSpam("MaZi", "CONTROLLER CHANGED ...");
		var int iDom = -3;
		var int i, iC = m_xSectors.NumEntries();
		for(i=0) cond(i<iC) iter(++i) do
			if(m_xSectors[i].IsValid()) then
				var ^CKOTHSector pxSec = cast<CKOTHSector>(m_xSectors[i].GetObj());
				if(pxSec!=null) then
					var int iOwnTeam = pxSec^.GetOwningTeam();
					if(iOwnTeam!=iDom && iDom==-3) then
						iDom = iOwnTeam;
					elseif(iOwnTeam!=iDom) then
						iDom = -2;
					endif;
				endif;
			endif;
		endfor;
		
		var string sName="";
		if(iDom>=0) then
			var ^CLevel pxLevel=CSrvWrap.GetCurLevel();
			iC = 8;
			for(i=0) cond(i<iC) iter(++i) do
				var ^CPlayer pxPlayer=pxLevel^.GetPlayer(i);
				if(pxPlayer!=null) then
					if(pxPlayer^.GetTeamID()==iDom) then
						if(sName.IsEmpty()) then
							sName = pxPlayer^.GetPlayerSlot()^.GetName();
						else
							sName = "Team_"+iDom.ToString();
							break;
						endif;
					endif;
				endif;
			endfor;
		endif;
		CSrvWrap.SendGenericEvtToClients(0ffh, "Counter\tSetAdditionalText\t"+sName);
		
		var ^CKOTHTimer pxTimer = cast<CKOTHTimer>(m_xTimer.GetObj());
		if(pxTimer!=null) then
			if(iDom>=-1) then
				m_iLastDominator = m_iCurDominator;
				m_iCurDominator = iDom;
				if(m_iCurDominator!=m_iLastDominator) then
					pxTimer^.Reset();
					if(m_iCurDominator>=0) then
						pxTimer^.Start();
						CSrvWrap.SendGenericEvtToClients(0ffh, "Counter\tSetAdditionalText\t"+sName);
					else
						CSrvWrap.SendGenericEvtToClients(0ffh, "Counter\tSetAdditionalText\t");
					endif;
				elseif(m_iCurDominator>=0) then
					pxTimer^.Start();
				endif;
			else
				pxTimer^.Stop();
			endif;
		endif;
	endproc;
endclass;