class CResourceBuildUp inherit CBuildUpDesc

	export var CObjHndl	m_xCurMiningObj;
	export var CObjHndl	m_xCurDelivery;

	export class CResCarry
		export var CFourCC	m_xResType;
		export var int		m_iCapacity;
		export var int		m_iAmount;
	endclass

	export var array CResCarry	m_axReses;

	export constructor()
		m_xType = "Ress";
		m_xParent = CObjHndl.Invalid();
		m_bTrail = false;
	endconstructor;

	export constructor(CObjHndl p_xParent, CObjHndl p_xObject)
		m_xType = "Ress";
		m_xParent = p_xParent;
		m_xLinkedObj = p_xObject;
		m_bTrail = false;
	endconstructor;

	export proc void OnActionStart()
	endproc;

	export proc void OnActionEnd(bool p_bBroken)
	endproc;

	export proc bool CanMine ( CFourCC p_xResType )
		var int i, iC = m_axReses.NumEntries();
		for (i = 0) cond (i < iC) iter (++i) do
			if (m_axReses[i].m_xResType == p_xResType) then
				return true;
			endif;
		endfor;
		return false;
	endproc;

	// Adds p_iAmount of ressources
	export proc bool AddReses ( CFourCC p_xResType, int p_iAmount)
		var ^CResCarry pxRC = GetResCarry(p_xResType);

		if (pxRC != null) then
			if (pxRC^.m_iAmount + p_iAmount <= pxRC^.m_iCapacity) then
				pxRC^.m_iAmount += p_iAmount;
				return true;
			endif;
		endif;
		return false;
	endproc;

	// clears all resources of this restype and returns the amount
	export proc int ClearReses( CFourCC p_xResType )
		var ^CResCarry pxRC = GetResCarry(p_xResType);
		var int iRes = 0;
		if (pxRC != null) then
			iRes = pxRC^.m_iAmount;
			pxRC^.m_iAmount = 0;
		endif;
		return iRes;
	endproc;

	export proc void StartMining(CObjHndl p_xWhere)
		if (!p_xWhere.IsValid() && !CanMine(p_xWhere.GetObj()^.GetType()) ) then return; endif;

		if (OnStartMining(p_xWhere)) then
			m_xCurMiningObj = p_xWhere;
		endif;
	endproc;

	export proc void StopMining()
		if (!m_xCurMiningObj.IsValid()) then return; endif;

		if (OnStopMining()) then
			m_xCurMiningObj = CObjHndl.Invalid();
			m_xCurDelivery = CObjHndl.Invalid();
		endif;
	endproc;

	export proc bool PlayWorkAnim()
		return false;
	endproc;

	export proc bool OnStartMining(CObjHndl p_xWhere)
		// Override me ... please
		return false;
	endproc;

	export proc bool OnStopMining()
		// Override me ... please
		return false;
	endproc;

	// private -- returns a pointer to the ResCarry for the specified type
	export proc ^CResourceBuildUp.CResCarry GetResCarry(CFourCC p_xResType)
		var int i, iC = m_axReses.NumEntries();

		for (i = 0) cond (i < iC) iter (++i) do
			if (m_axReses[i].m_xResType == p_xResType) then
				return ^m_axReses[i];
			endif;
		endfor;
		return null;
	endproc;
endclass;

// ##################################

class CLumberUpgrade inherit CResourceBuildUp

	export constructor()
		m_xType = "Ress";
		m_xParent = CObjHndl.Invalid();
		m_bTrail = false;
		Init();
	endconstructor;

	export constructor(CObjHndl p_xParent, CObjHndl p_xObject)
		m_xType = "Ress";
		m_xParent = p_xParent;
		m_xLinkedObj = p_xObject;
		m_bTrail = false;
		Init();
	endconstructor;

	export destructor()
	enddestructor;

	proc void Init()
		/*var CResourceBuildUp.CResCarry xTmp;
		xTmp.m_xResType = "WOOD";
		xTmp.m_iCapacity = 100;
		xTmp.m_iAmount = 0;
		*/
		var CResourceBuildUp.CResCarry xRC;
		xRC.m_xResType = "WOOD";
		xRC.m_iCapacity = 1000;
		xRC.m_iAmount = 0;

		m_axReses.AddEntry(xRC);
	endproc;

	export proc void ShowLog(bool p_bShow)
		var CFourCC xLink = "psh1";
		var ^CGameObj pxO = m_xLinkedObj.GetObj();
		if (pxO == null) then return; endif;
		if (p_bShow) then
			pxO^.SetLinkGFX(xLink, "Treedummy_Big");
		else
			pxO^.RemLinkGFX(xLink);
		endif;
	endproc;

	export proc bool PlayWorkAnim()
		var ^CTransportObj pxTO = cast<CTransportObj>(m_xParent.GetObj());
		if (pxTO != null) then
			pxTO^.SetAnim("treejog", 3);
			return true;
		endif;
		return false;
	endproc;

	export proc void OnActionStart()
	endproc;

	export proc void OnActionEnd(bool p_bBroken)
	endproc;

	export proc bool OnStartMining(CObjHndl p_xWhere)
		return true;
	endproc;

	export proc bool OnStopMining()
		return true;
	endproc;

endclass;