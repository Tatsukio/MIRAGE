class CUniversalTriggerCondition inherit IUniversalTriggerCondition

	var CObjFinder	m_xObjFinder;
	var CObjFinder	m_xObjFinder2;

	export constructor()
	endconstructor;

	export constructor(ref CAttribs p_rxArgs)
		Init(p_rxArgs);
		m_xObjFinder.Init(p_rxArgs);
		m_xObjFinder2.Init(p_rxArgs,"B_");
	endconstructor;

	proc bool Initialize()
		super.Initialize();

		return true;
	endproc;

	proc bool OnEnabled()
		super.OnEnabled();
		return true;
	endproc;

	proc bool OnDisabled()
		super.OnDisabled();
		return true;
	endproc;

	proc bool OnPush(ref CEvtPointer p_rxEP)
		super.OnPush(p_rxEP);
		return true;
	endproc;

	proc void OnSelectUnits(ref CObjList p_rxUnits)
		var CObjList xQueryObjs;
		m_xObjFinder.MakeQuery(xQueryObjs);
		var int i,iC = p_rxUnits.NumEntries();
		for(i = 0)cond(i < iC)iter(i++)do
			if(xQueryObjs.FindEntry(p_rxUnits[i]) != -1)then
				SetState(0);
				SetState(1);
				Invalidate();
				break;
			endif;
		endfor;
	endproc;

	proc void OnDeselectUnits(ref CObjList p_rxUnits)
		var CObjList xQueryObjs;
		m_xObjFinder.MakeQuery(xQueryObjs);
		var int i,iC = p_rxUnits.NumEntries();
		for(i = 0)cond(i < iC)iter(i++)do
			if(xQueryObjs.FindEntry(p_rxUnits[i]) != -1)then
				SetState(0);
				SetState(1);
				Invalidate();
				break;
			endif;
		endfor;
	endproc;

	proc void OnTransportMount(CObjHndl p_xTransporter,CObjHndl p_xPassenger)
		if(GetConditionType() == "TRMO")then
			begin CheckTransporter;
				var CObjList xQueryObjs;
				m_xObjFinder.MakeQuery(xQueryObjs);
				if(xQueryObjs.FindEntry(p_xTransporter) == -1)then
					return;
				endif;
			end CheckTransporter;
			begin CheckPassanger;
				var CObjList xQueryObjs;
				m_xObjFinder2.MakeQuery(xQueryObjs);
				if(xQueryObjs.FindEntry(p_xPassenger) == -1)then
					return;
				endif;
			end CheckPassanger;
			SetState(0);
			SetState(1);
			Invalidate();
		endif;
	endproc;

	proc void Load(^CUOFReaderNode p_pxReaderNode)
		if(p_pxReaderNode^.GetType() == "CUTC")then
			var ^CArc pxArc = ^(p_pxReaderNode^.GetArc());
			var int iVersion = p_pxReaderNode^.GetVersion();
			m_xObjFinder.DoKArc(pxArc^);
			if(iVersion >= 1)then
				m_xObjFinder2.DoKArc(pxArc^);
			endif;
		else
			super.Load(p_pxReaderNode);
		endif;
	endproc;
	proc void Save(^CUOFWriterNode p_pxWriterNode)
		super.Save(p_pxWriterNode);
		var CFourCC xF = "CUTC";
		var ^CUOFWriterNode pxN = p_pxWriterNode^.AddSubChunk(xF,1);
		var ^CArc pxArc = ^(pxN^.GetArc());
		m_xObjFinder.DoKArc(pxArc^);
		m_xObjFinder2.DoKArc(pxArc^);
		pxN^.Close();
	endproc;
endclass;