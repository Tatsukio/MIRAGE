class CStatsMgr

	class CPlayerStats

		class CTributeStats inherit CEvtSource

			export static var array string	ms_asResources;
			export var array int			m_aiAmount;

			export constructor()
				if(ms_asResources.NumEntries() != 4) then
					ms_asResources = 4;
					ms_asResources[0] = "food";
					ms_asResources[1] = "wood";
					ms_asResources[2] = "stone";
					ms_asResources[3] = "scalps";
				endif;
				m_aiAmount = 4;
			endconstructor;
		endclass;

		var int					m_iPlayer;
		var array CTributeStats	m_axTributes;

		export constructor(int p_iPlayer)
			m_axTributes = 8;
			m_iPlayer = p_iPlayer;
		endconstructor;

		export proc void AddTribute(int p_iToPlayer, string p_sResource, int p_iAmount)
			if(p_iToPlayer == m_iPlayer) then return; endif;

			var ^CTributeStats pxStat = ^(m_axTributes[p_iToPlayer]);
			var int iIdx = pxStat^.ms_asResources.FindEntry(p_sResource);
			if(iIdx >= 0) then
				pxStat^.m_aiAmount[iIdx] += p_iAmount;
				var CEvtPointer xEvt = CEvtPointer.CreateEvent("STAT_TRB");
				xEvt.SetInt(0, iIdx);						// ResourceID
				xEvt.SetInt(1, pxStat^.m_aiAmount[iIdx]);	// New Amount
				pxStat^.Broadcast(xEvt);
			endif;
		endproc;

		export proc ^CStatsMgr.CPlayerStats.CTributeStats GetTributeStats(int p_iReceiver)
			return ^(m_axTributes[p_iReceiver]);
		endproc;

		export static proc string GetResourceNameByID(int p_iID)
			return CStatsMgr.CPlayerStats.CTributeStats.ms_asResources[p_iID];
		endproc;

		export static proc int GetResourceIDByName(string p_sRes)
			return CStatsMgr.CPlayerStats.CTributeStats.ms_asResources.FindEntry(p_sRes);
		endproc;
	endclass;

	static var ^CStatsMgr	ms_pxInst;
	var array ^CPlayerStats	m_apxStats;

	export static proc ref CStatsMgr Get()
		if(ms_pxInst == null)then ms_pxInst = new CStatsMgr(); endif;
		return ms_pxInst^;
	endproc;

	export static proc void StaticShut()
		delete ms_pxInst;
	endproc;

	constructor()
		// TODO: Read the current Player-Count from LevelInfo
		m_apxStats = 8;
		var int i, iC = 8;
		for(i = 0) cond(i < iC) iter(++i) do
			m_apxStats[i] = new CPlayerStats(i);
		endfor;
	endconstructor;

	destructor()
		var int i, iC = m_apxStats.NumEntries();
		for(i = 0) cond(i < iC) iter(++i) do
			delete m_apxStats[i];
		endfor;
		m_apxStats = 0;
	enddestructor;

	export proc ^CStatsMgr.CPlayerStats GetPlayerStats(int p_iPlayer)
		return m_apxStats[p_iPlayer];
	endproc;

endclass;