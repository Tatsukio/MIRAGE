	export proc bool HandleMsg(bitset p_dwType, bitset p_dwFlags, int p_iKey, int p_iX, int p_iY)

		m_pxSelection = ^(CClientWrap.GetSelection());

		var bool bReturn=false;
		var bool bAlt=false;

		if(p_dwType==CInputController.MT_MouseLBtnDown)then m_bLMB=true;		
		elseif(p_dwType==CInputController.MT_MouseLBtnUp)then m_bLMB=false;
		elseif((p_dwType==CInputController.MT_MouseRBtnDown)||(p_dwType==CInputController.MT_MouseRBtnDoubleClick))then m_bRMB=true;
		elseif(p_dwType==CInputController.MT_MouseRBtnUp)then m_bRMB=false;
		elseif(p_dwType==CInputController.MT_Tick)then
			if(m_bAutoFollow)then
				AutoFollow();
			else
				FreeView();
			endif;
			return true;
		endif;
		
		if(m_bLMB)then
			//if(!m_bLMB)then
			//	m_bLMB=true;
			//endif;
			//m_xDragBoxBegin.SetX(p_iX);
			//m_xDragBoxBegin.SetY(p_iY);
		endif;
		
		if(m_bRMB)then
			var CClntHndl	xInvalid;
			if(m_xTarget.IsValid())then
				CEvt_GamePlayCommand.Send(m_xTarget, "walk", xInvalid, CClientWrap.GetScapeMgr().GetPickPoint(), "");
			endif;
		endif;
		
		if(!m_bLMB)then
			var ^CDragBox pxDragBox=^(CClientWrap.GetDragBox());
			if(pxDragBox!=null && pxDragBox^.IsActive()) then
				pxDragBox^.DragEnd(m_xMousePos);
			endif;
		endif;

		if( (p_dwFlags&0100b) == 00100b )then
			bAlt=true;
			bReturn = true;
		endif;
		if(p_dwType == CInputController.MT_MouseMove)then
			CGameWrap.LogSpam("Controller.ActionView","m_xLastMousePos="+m_xLastMousePos.ToString()+" m_bLMB="+m_bLMB.ToString());

			if(!m_bAutoFollow)then
				var int iDiffX=0;
				var int iDiffY=0;
				iDiffX=p_iX-m_iLastX;
				iDiffY=p_iY-m_iLastY;

				if(!m_bLMB && !bAlt)then
					m_iLastX=p_iX;
					m_iLastY=p_iY;
				else
					m_iLastX = m_xLastMousePos.GetX();
					m_iLastY = m_xLastMousePos.GetY();
				endif;

				if(bAlt)then
					bReturn = false;
					var real fXScale=(-0.005);
					var real fXChange=iDiffX.ToReal()*fXScale;
					CWindowMgr.Get().SetMousePosNoMMove(m_xLastMousePos);
					m_fRotate=fXChange;
					bReturn = true;
					if(!bReturn)then
						m_xLastMousePos.SetX(p_iX);
						m_xLastMousePos.SetY(p_iY);
					endif;
				endif;
				if(!bReturn)then
					m_xLastMousePos.SetX(p_iX);
					m_xLastMousePos.SetY(p_iY);
				endif;
				SnapOnTarget();
			endif;
		endif;

		return(bReturn);
	endproc;

	proc void FreeView()
		if(!m_xTarget.IsValid())then
			LeaveActionView();
		else
			SnapOnTarget();
		endif;
	endproc;

	proc void AutoFollow()
		//Under Construction
		if(!m_xTarget.IsValid())then
			LeaveActionView();
		else
			SnapOnTarget();
			var ^CObj pxTarget = m_xTarget.GetObj();
			if(pxTarget==null)then	return;	endif;
			var vec3 vVec = {0.0,-15.0,5.0};
			if(pxTarget^.GetHandle().IsValid())then
				vVec.RotZ(pxTarget^.GetHandle().GetObj()^.GetRotation().GetZ());
			endif;

			var vec3	vDiff=m_pxCurCamera^.Eye()-(m_pxCurCamera^.LookAt()+vVec);
			var	real	fSpeedX=0.5;
			var	real	fSpeedY=0.5;
			var	real	fSpeedZ=2.0;

			if(vDiff.GetX()!=0.0)then
				if(vDiff.GetX()>0.0)then
					if(vDiff.GetX()<fSpeedX)then
						vDiff.SetX(0.0);
					else
						vDiff.SetX(vDiff.GetX()-fSpeedX);
					endif;
				elseif(vDiff.GetX()<0.0)then
					if(vDiff.GetX()>(-fSpeedY))then
						vDiff.SetX(0.0);
					else
						vDiff.SetX(vDiff.GetX()+fSpeedX);
					endif;
				endif;
			endif;

			if(vDiff.GetY()!=0.0)then
				if(vDiff.GetY()>0.0)then
					if(vDiff.GetY()<fSpeedY)then
						vDiff.SetY(0.0);
					else
						vDiff.SetY(vDiff.GetY()-fSpeedY);
					endif;
				elseif(vDiff.GetY()<0.0)then
					if(vDiff.GetY()>(-fSpeedY))then
						vDiff.SetY(0.0);
					else
						vDiff.SetY(vDiff.GetY()+fSpeedY);
					endif;
				endif;
			endif;

			if(vDiff.GetZ()!=0.0)then
				if(vDiff.GetZ()>0.0)then
					if(vDiff.GetZ()<fSpeedZ)then
						vDiff.SetZ(0.0);
					else
						vDiff.SetZ(vDiff.GetZ()-fSpeedZ);
					endif;
				elseif(vDiff.GetZ()<0.0)then
					if(vDiff.GetZ()>(-fSpeedZ))then
						vDiff.SetZ(0.0);
					else
						vDiff.SetZ(vDiff.GetZ()+fSpeedZ);
					endif;
				endif;
			endif;
			m_pxCurCamera^.Eye() = (m_pxCurCamera^.LookAt()+vVec)+vDiff;
		endif;
	endproc;

	proc void SnapOnTarget()
		var ^CObj pxTarget = m_xTarget.GetObj();
		var ^CObj pxLookAtTarget = m_xLookAtTarget.GetObj();
		if(pxTarget==null)then	return;	endif;
		var vec3 vLookAt = m_pxCurCamera^.Eye() - m_pxCurCamera^.LookAt();
		vLookAt.RotZ(m_fRotate);

		m_pxCurCamera^.LookAt() = pxTarget^.GetPos()+{0.0,0.0,2.0};
		m_pxCurCamera^.Eye() = m_pxCurCamera^.LookAt()+vLookAt;
		m_fRotate = 0.0;
	endproc;

	export proc void Control(^CCamera p_pxCamera)
		m_pxCurCamera= p_pxCamera;
	endproc;

endclass;
*/