class CSequencePlayerModule inherit CCameraControllerModule
	var vec3	m_vEye;
	var vec3	m_vLookAt;
	var vec3	m_vUp;
	var real	m_fFOV;

	export var bool	m_bResetAtEnd;

	export constructor()
		m_sModuleName = "SequencePlayer";
	endconstructor;

	export proc void PreActivate(^CCamera p_pxCamera)
		m_vEye = p_pxCamera.Eye();
		m_vLookAt = p_pxCamera.LookAt();
		m_vUp = p_pxCamera.Up();
		m_fFOV = p_pxCamera.FOV();
	endproc;

	export proc void OnDeactivate(^CCamera p_pxCamera)
	endproc;

	export proc bool OnTick()
		UpdateFromCamera(p_pxCamera);
		return false;
	endproc;

	export proc void OnStartSequence()
	endproc;

	export proc void OnEndSequence()
		if(m_bResetAtEnd)then

		endif;
	endproc;

endclass;