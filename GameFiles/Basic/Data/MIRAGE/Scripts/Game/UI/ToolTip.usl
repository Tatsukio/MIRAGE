class CToolTip inherit CStaticCtrl

	var CGameTime m_xTimer;
	var int m_iCheckTimer;
	var string m_sMsg;

	export constructor()
		SetVisible(false);

		//L CGameWrap.LogSpam("Interface","tooltip timer set");
		m_iCheckTimer = SetTimer(50, true);
	endconstructor;

	export destructor()
	enddestructor;

	export proc bool OnToolTip(string p_sMsg)
		
		if(p_sMsg != m_sMsg)then
			m_sMsg = p_sMsg;
			SetVisible(true);
			SetText(p_sMsg);
			AutoSize(true);
			SetPos(1014-GetSize().GetX(),570-GetSize().GetY());
		endif;
		m_xTimer = CTimeMgr.Get().GetTime();
		return false;
	endproc;

	proc bool OnTimer(int p_iID)
		if (p_iID == m_iCheckTimer) then
			var real fTime = (CTimeMgr.Get().GetTime()-m_xTimer).GetSecondsF();
			if(fTime>0.1)then
				if(GetVisible())then
					SetVisible(false);
					m_sMsg = "";
				endif;
			endif;
		endif;
		return true;
		
	endproc;

endclass;
