//MultiPlayerMenu.usl

class CSoundMonitor inherit CFrameWindow

	static var ^CSoundMonitor	ms_pxInstance;			// singleton instance

	constructor()
		if(!InitFromResource("UI/SoundMonitor","SoundMonitor")) then
			return;
		endif;
		
		SetAlwaysOnTop(true);
	endconstructor;


	destructor()
	enddestructor;


	export static proc void CreateStatic()
		if(ms_pxInstance == null) then
			ms_pxInstance = new CSoundMonitor();
			CClientWrap.GetDesktop()^.AddChild(ms_pxInstance);
			CWindowMgr.Get().BringWindowToTop(ms_pxInstance, true);
		endif;
	endproc;

	
	export static proc void ShutStatic()
		if(ms_pxInstance != null) then
			delete ms_pxInstance;
			ms_pxInstance = null;
		endif;
	endproc;


	export static proc void ToggleStatic()
		if(ms_pxInstance == null) then
			CreateStatic();
		else
			ms_pxInstance^.SetVisible(!ms_pxInstance^.GetVisible());
		endif;
	endproc;

	
	export proc bool OnClose()
		SetVisible(false);
		return true;
	endproc;

endclass;

