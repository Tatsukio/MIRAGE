class CGameSettingsWindow inherit CFrameWindow

	var ^CDesktop	m_pxDesktop;

	var ^CSlider			m_pxGameSpeedSlider;
	var ^CStaticCtrl		m_pxGameSpeedStatic;
	var ^CCheckBox			m_pxLockGameSpeedCheckBox;
	var ^CCheckBox			m_pxPauseLimitCheckBox;
	var ^CSpinCtrlNumber	m_pxPauseLimitSpinCtrl;
	var ^CCheckBox			m_pxLockTeamsCheckBox;
	var ^CCheckBox			m_pxShareUnitsCheckBox;
	var ^CCheckBox			m_pxShareResourcesCheckBox;
	var ^CCheckBox			m_pxBuildingTimeoutCheckBox;
	var ^CSpinCtrlNumber	m_pxBuildingTimeoutSpinCtrl;

	var bool	m_bHost;

	export constructor(bool p_bHost)
		if (!InitFromResource("UI/GameSettingsWindow","GameSettingsWindow")) then
			CGameWrap.LogError("UI.GameSettingsWindow","InitFromResource failed");
			return;
		endif;
		SetCaption(CLocalizer.Get().Translate("_UI_GameSWin_Title_GameSettings"));
		var ^CBoxLayout pxLayout = new CBoxLayout("main", 1);
		SetLayoutMgr(pxLayout);
		pxLayout^.SetCellPadding(0,0);
		pxLayout^.AddBox("main",CBoxLayout.BT_Fill, 0.9,"fill");
		pxLayout^.AddBox("main",CBoxLayout.BT_Fixed, 37.0,"bottom");
		pxLayout^.AddBox("bottom",CBoxLayout.BT_Fixed, 50.0,"lborder");
		pxLayout^.AddBox("bottom",CBoxLayout.BT_Fill, 0.9,"fill");
		pxLayout^.AddBox("bottom",CBoxLayout.BT_Fixed, 100.0,"cancel");
		pxLayout^.AddBox("bottom",CBoxLayout.BT_Fixed, 65.0,"rborder");
		var ^CButton pxCloseButton = new CButton();
		pxCloseButton^.SetText(CLocalizer.Get().Translate("_UI_GameSWin_Button_Close"));
		AddChildWithLayout(pxCloseButton, "cancel");
		pxCloseButton^.m_xOnClick = OnClose;

		m_bHost = p_bHost;
		m_pxDesktop = CClientWrap.GetDesktop();

		m_pxGameSpeedSlider = cast<CSlider>(GetControl("GameSpeedSlider"));
		m_pxGameSpeedSlider^.m_xOnChange = OnGameSpeedSlider;
		m_pxGameSpeedSlider^.SetDisabled(true);

		m_pxGameSpeedStatic = cast<CStaticCtrl>(GetControl("GameSpeedStatic"));

		m_pxLockGameSpeedCheckBox = cast<CCheckBox>(GetControl("GameSpeedLockCheckBox"));
		m_pxLockGameSpeedCheckBox^.m_xOnStateChange = OnChangeLockGameSpeed;

		m_pxPauseLimitCheckBox = cast<CCheckBox>(GetControl("PauseLimitCheckBox"));
		m_pxPauseLimitCheckBox^.m_xOnStateChange = OnChangePauseLimit;

		m_pxPauseLimitSpinCtrl = cast<CSpinCtrlNumber>(GetControl("PauseLimitSpinCtrl"));
		m_pxPauseLimitSpinCtrl^.m_xOnChange = OnChangePauseLimitAmount;
		m_pxPauseLimitSpinCtrl^.SetLimits(1,20,1);

		m_pxLockTeamsCheckBox = cast<CCheckBox>(GetControl("LockTeamsCheckBox"));
		m_pxLockTeamsCheckBox^.m_xOnStateChange = OnChangeLockTeams;

		m_pxShareUnitsCheckBox = cast<CCheckBox>(GetControl("TeamUnitsCheckBox"));
		m_pxShareUnitsCheckBox^.m_xOnStateChange = OnChangeShareUnits;

		m_pxShareResourcesCheckBox = cast<CCheckBox>(GetControl("TeamResourcesCheckBox"));
		m_pxShareResourcesCheckBox^.m_xOnStateChange = OnChangeShareResources;

		m_pxBuildingTimeoutCheckBox = cast<CCheckBox>(GetControl("BuildingTimeOutCheckBox"));
		m_pxBuildingTimeoutCheckBox^.m_xOnStateChange = OnChangeBuildingTimeOut;

		m_pxBuildingTimeoutSpinCtrl = cast<CSpinCtrlNumber>(GetControl("BuildingTimeoutSpinCtrl"));
		m_pxBuildingTimeoutSpinCtrl^.m_xOnChange = OnChangeBuildingTimeOutSpinCtrl;

		if (!m_bHost) then
			m_pxGameSpeedSlider^.SetDisabled(true);
			m_pxGameSpeedStatic^.SetDisabled(true);
			m_pxLockGameSpeedCheckBox^.SetDisabled(true);
			m_pxPauseLimitCheckBox^.SetDisabled(true);
			m_pxPauseLimitSpinCtrl^.SetDisabled(true);
			m_pxLockTeamsCheckBox^.SetDisabled(true);
			m_pxShareUnitsCheckBox^.SetDisabled(true);
			m_pxShareResourcesCheckBox^.SetDisabled(true);
			m_pxBuildingTimeoutCheckBox^.SetDisabled(true);
			m_pxBuildingTimeoutSpinCtrl^.SetDisabled(true);
		endif;
	endconstructor;

	export destructor()

	enddestructor;

	export proc bool OnGameSpeedSlider()
		//L KLog.LogWarn("GameSettings","OnGameSpeedSlider()");
		return true;
	endproc;

	export proc bool OnChangeLockGameSpeed()
		return true;
	endproc;

	export proc bool OnChangePauseLimit()

		return true;
	endproc;

	export proc bool OnChangePauseLimitAmount()

		return true;
	endproc;

	export proc bool OnChangeLockTeams()
		return true;
	endproc;

	export proc bool OnChangeShareUnits()
		return true;
	endproc;

	export proc bool OnChangeShareResources()
		//L KLog.LogWarn("GameSettings","OnChangeShareResources()");
		return true;
	endproc;

	export proc bool OnChangeBuildingTimeOut()
		//L KLog.LogWarn("GameSettings","OnChangeBuildingTimeOut()");
		return true;
	endproc;

	export proc bool OnChangeBuildingTimeOutSpinCtrl()
		//L KLog.LogWarn("GameSettings","OnChangeBuildingTimeOutSpinCtrl()");
		return true;
	endproc;

	export proc bool OnClose()
		SetVisible(false);
		CWindowMgr.Get().ReleaseModal(this);
		return true;
	endproc;

	export proc bool SaveLevelInfo()
		//Lock Gamespeed
		var int iChecked = m_pxLockGameSpeedCheckBox^.GetChecked();
		var ^CLevelInfoClient pxLevelInfo = ^(CGameWrap.GetClient().GetLevelPreview());
		pxLevelInfo^.GetAttribs().SetValue("GameSpeedLock",iChecked);
		//PauseLimit
		iChecked = m_pxPauseLimitCheckBox^.GetChecked();
		pxLevelInfo^.GetAttribs().SetValue("PauseLimit",iChecked);
		//PauseAmount
		var int iValue = m_pxPauseLimitSpinCtrl^.GetValueInt();
		pxLevelInfo^.GetAttribs().SetValue("PauseLimitAmount",iValue);
		//LockTeams
		iChecked = m_pxLockTeamsCheckBox^.GetChecked();
		pxLevelInfo^.GetAttribs().SetValue("LockTeams",iChecked);
		//ShareUnits
		iChecked = m_pxShareUnitsCheckBox^.GetChecked();
		pxLevelInfo^.GetAttribs().SetValue("TeamUnitShare",iChecked);
		//ShareResources
		iChecked = m_pxShareResourcesCheckBox^.GetChecked();
		pxLevelInfo^.GetAttribs().SetValue("TeamResourceShare",iChecked);
		return true;
	endproc;

endclass;

