class CGameLoadSaveDialog inherit CLoadSaveDialog

	export var procref<bool,string>	m_xOnReturnFileString;
	export constructor( int p_iType )

		var string sPath;
		SetType((p_iType) % 2);

		if(p_iType == 0)then
			SetCmd("Submit",OnOpen);
		else
			SetCmd("Submit",OnSave);
		endif;
		SetCmd("Exit", OnClose );
		AddAccelerator("RETURN,NONE,Submit");
		AddAccelerator("ESCAPE,NONE,Exit");
		CSettings.Get("Game/Windows/LoadSaveDialog/SavePath",sPath);
		SetPath(sPath);
	endconstructor;

	export destructor()
	enddestructor;

	proc bool OnOpen()
		SavePathString(GetSelectedFile());
		ReturnFileString(GetSelectedFile());
		return true;
	endproc;

	proc bool OnSave()
		SavePathString(GetSelectedFile());
		ReturnFileString(GetSelectedFile());
		return true;
	endproc;

	proc bool ReturnFileString( string p_sString )
		m_xOnReturnFileString.Call(p_sString);
		return(true);
	endproc;

	proc void SavePathString(string p_sPath);
		var string sPath = p_sPath.Left(p_sPath.FindRev('/'));
		CSettings.Set("Game/Windows/LoadSaveDialog/SavePath",sPath);
	endproc;

endclass;
