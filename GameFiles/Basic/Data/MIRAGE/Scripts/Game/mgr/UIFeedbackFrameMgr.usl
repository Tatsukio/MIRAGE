class CUIFeedbackFrameMgr

	static var ^CUIFeedbackFrameMgr ms_pxInst;
	
	class CFrameInfo
		export var string			m_sName;
		export var int 				m_iFeedbackHandle;
		
		export var int				m_iFeedbackType;
		export var int				m_iFrameWidth;
		export var color			m_xColor1;
		export var color			m_xColor2;		
		
		export var rect				m_xScreenRect;				
		export var vec3				m_vWorldPos;
		export var point			m_xSize;		
		export var CClntHndl		m_xObjHandle;
		
		
		export constructor()
			m_iFeedbackHandle=-1;
		endconstructor;
		
		export destructor()			
		enddestructor;
	endclass;
	
	var array CFrameInfo m_axFrames;
	
	export constructor()
		var ^CLevelInfo pxLevelInfo=^(CGameWrap.GetClient().GetLevelInfo());
		var ^CPropDB.CNode pxFFNode=^((pxLevelInfo^.GetGenericData())["FeedbackFrames"]);
		var int i,iC=pxFFNode^.NumSubs();
		for(i=0)cond(i<iC)iter(i++)do
			var ^CFrameInfo pxNewFrame=^(m_axFrames.NewEntryRef());
			var ^CPropDB.CNode pxWalk=^((pxFFNode^)[i]);
			pxNewFrame^.m_sName=pxWalk^.Name();
			pxNewFrame^.m_iFeedbackType=pxWalk^.GetValueI("type");			
			pxNewFrame^.m_xScreenRect.FromString(pxWalk^.GetValueS("screenrect",""));
			pxNewFrame^.m_iFrameWidth=pxWalk^.GetValueI("framewidth");
			pxNewFrame^.m_xColor1.FromString(pxWalk^.GetValueS("color1","255 0 0 255"));
			pxNewFrame^.m_xColor2.FromString(pxWalk^.GetValueS("color2","0 255 0 255"));
			pxNewFrame^.m_vWorldPos.FromString(pxWalk^.GetValueS("worldpos",""));
			pxNewFrame^.m_xSize.FromString(pxWalk^.GetValueS("size","10 10"));			
		endfor;	
	endconstructor;
	
	export static proc ref CUIFeedbackFrameMgr Get()
		if(ms_pxInst==null)then
			ms_pxInst=new CUIFeedbackFrameMgr;
		endif;	
		return (ms_pxInst^);
	endproc;
	
	export static proc void ShutStatic()
		delete ms_pxInst;
	endproc;
	
	export proc void FeedbackFrameActivate(string p_sFrameName,CGuid p_xObjGuid)
		var ^CFrameInfo pxFrame=null;
		var int i,iC=m_axFrames.NumEntries();
		for(i=0)cond(i<iC)iter(i++)do
			if(m_axFrames[i].m_sName==p_sFrameName)then
				pxFrame=^m_axFrames[i];
				break;
			endif;
		endfor;
		if(pxFrame==null)then
			return;
		endif;
		var ^CUIMgr pxUIMgr=^(CClientWrap.GetUIMgr());
		pxUIMgr^.DelFeedbackFrame(pxFrame^.m_iFeedbackHandle);
		if(pxFrame^.m_iFeedbackType==0)then//screen			
			pxFrame^.m_iFeedbackHandle=pxUIMgr^.AddFeedbackFrameScreen(pxFrame^.m_xScreenRect,pxFrame^.m_iFrameWidth,pxFrame^.m_xColor1,pxFrame^.m_xColor2);
		elseif(pxFrame^.m_iFeedbackType==1)then//worldpos
			pxFrame^.m_iFeedbackHandle=pxUIMgr^.AddFeedbackFrameWorld(pxFrame^.m_vWorldPos,pxFrame^.m_xSize,pxFrame^.m_iFrameWidth,pxFrame^.m_xColor1,pxFrame^.m_xColor2);
		elseif(pxFrame^.m_iFeedbackType==2)then//obj
			var ^CObj pxObj=CClientWrap.GetObjMgr().GetObj(p_xObjGuid);
			if(pxObj!=null)then
				pxFrame^.m_xObjHandle=pxObj^.GetHandle();
				pxFrame^.m_iFeedbackHandle=pxUIMgr^.AddFeedbackFrameObj(pxObj^.GetHandle(),pxFrame^.m_xSize,pxFrame^.m_iFrameWidth,pxFrame^.m_xColor1,pxFrame^.m_xColor2);
			endif;			
		endif;		
		
	endproc;
	
	export proc void FeedbackFrameDeactivate(string p_sFrameName)
		var int i,iC=m_axFrames.NumEntries();
		for(i=0)cond(i<iC)iter(i++)do
			if(m_axFrames[i].m_sName==p_sFrameName)then
				CClientWrap.GetUIMgr().DelFeedbackFrame(m_axFrames[i].m_iFeedbackHandle);
				m_axFrames[i].m_iFeedbackHandle=-1;
				m_axFrames[i].m_xObjHandle.Invalidate();
				break;
			endif;
		endfor;
	endproc;
	
	export proc void OnDeleteObj(ref CClntHndl p_rxObj)
		var int i,iC=m_axFrames.NumEntries();
		for(i=0)cond(i<iC)iter(i++)do
			if(m_axFrames[i].m_xObjHandle==p_rxObj)then
				CClientWrap.GetUIMgr().DelFeedbackFrame(m_axFrames[i].m_iFeedbackHandle);
				m_axFrames[i].m_iFeedbackHandle=-1;
				m_axFrames[i].m_xObjHandle.Invalidate();
				break;
			endif;
		endfor;
	endproc;
	
endclass;
