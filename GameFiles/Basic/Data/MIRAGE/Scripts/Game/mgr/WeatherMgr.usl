class CWeatherMgr

	static var ^CWeatherMgr		ms_pxInst;

	//Class contains all tracks belonging to this program.
	class CWeatherProgram

		var ^CPropDB.CNode 				m_pxWeatherDB;			//Main DB
		var array ^CWeatherTrack		m_apxWeatherTracks;		//Array of program tracks
		var ^CWeatherTrack				m_pxCurrentTrack;		//Track currently playing
		var int							m_iCurrentTrack;		//Index of current track
		var bool						m_bLoop;				//Program loops if true
		var bool						m_bEnd;					//Tells if program is over

		export constructor(^CPropDB.CNode p_pxWeatherDB)
			m_pxWeatherDB=p_pxWeatherDB;
			var int i,iC=m_pxWeatherDB^.Get("Tracks")^.NumSubs();
			var ^CPropDB.CNode pxTracks=m_pxWeatherDB^.Get("Tracks");
			for(i=0)cond(i<iC)iter(i++)do
				var ^CWeatherTrack	pxTempTrack;
				var	CGameTimeSpan	xTrackLength;
				var int				iType;
				var int				iWindDir;
				var int				iWindStrength;
				var int				iIntensity;
				xTrackLength=(pxTracks^)[i].GetValueR("Duration")*60.0f;
				iType=(pxTracks^)[i].GetValueI("Type");
				iWindDir=(pxTracks^)[i].GetValueI("WindDir");
				iWindStrength=(pxTracks^)[i].GetValueI("WindStrength");
				iIntensity=(pxTracks^)[i].GetValueI("Intensity");
				pxTempTrack=new CWeatherMgr.CWeatherTrack(xTrackLength,iType,iWindDir,iWindStrength,iIntensity);				
				m_apxWeatherTracks.AddEntry(pxTempTrack);
			endfor;
			if(m_pxWeatherDB^.GetValueI("Loop")==1)then
				m_bLoop=true;
			else
				m_bLoop=false;
			endif;
			m_bEnd=false;
		endconstructor;

		export destructor()
			var int i,iC=m_apxWeatherTracks.NumEntries();
			for(i=0) cond(i<iC) iter(++i) do
				delete m_apxWeatherTracks[i];
			endfor;
			m_apxWeatherTracks=0;
		enddestructor;

		//Plays program, starting with track 0.
		export proc void Start()			
			m_apxWeatherTracks[0]^.Play();
			m_pxCurrentTrack=m_apxWeatherTracks[0];
			m_iCurrentTrack=0;
		endproc;

		//Stops program, by stoping the currently playing track.
		export proc void Stop()			
			if(m_pxCurrentTrack!=null)then
				m_pxCurrentTrack^.Stop();
			endif;
		endproc;

		//Obsolete.
		export proc void Pause(bool p_bParam)			
			if(m_pxCurrentTrack!=null)then
				m_pxCurrentTrack^.Pause(p_bParam);
			endif;
		endproc;

		//Called if track is over. Restarts program if m_bLoop is true.
		export proc void GoToNextTrack()			
			if((m_iCurrentTrack+1)<m_apxWeatherTracks.NumEntries())then
				m_iCurrentTrack++;
				m_apxWeatherTracks[m_iCurrentTrack]^.Play();
				m_pxCurrentTrack=m_apxWeatherTracks[m_iCurrentTrack];
			else
				if(m_bLoop)then
					m_apxWeatherTracks[0]^.Play();
					m_pxCurrentTrack=m_apxWeatherTracks[0];
					m_iCurrentTrack=0;
					m_bEnd=false;
				else
					CVisFXManager.FXWeather.Enable(false);
					CVisFXManager.FXWeather.SetIntensity(0);
					CVisFXManager.FXWeather.SetType(0);
					m_bEnd=true;
				endif;
			endif;
		endproc;

		//Returns whether program is over, or not.
		export proc bool IsOver()
			return(m_bEnd);
		endproc;

		//Returns track currently played.
		export proc ^CWeatherMgr.CWeatherTrack GetCurrentTrack()
			return(m_pxCurrentTrack);
		endproc;

	endclass

	//Class contains all information necessary to set the weather in CVisFXManager.
	class CWeatherTrack

		var CGameTimeSpan	m_xTrackLength;		//Length of the weather track
		var CGameTime		m_xStartTime;		//Time the track started
		var int				m_iType;			//Type of weather (Rain, Snow, ...)
		var int 			m_iWindDir;			//Direction of the wind
		var int 			m_iWindStrength;	//Strength of the wind (0.0f - 120.0f)
		var int				m_iIntensity;		//Intensity of the weather effect. Amount of raindrops and snowflakes.

		export constructor(CGameTimeSpan p_xTrackLength, int p_iType, int p_iWindDir, int p_iWindStrength, int p_iIntensity)
			m_xTrackLength=p_xTrackLength;
			m_iType=p_iType;
			m_iWindDir=p_iWindDir;
			m_iWindStrength=p_iWindStrength;
			m_iIntensity=p_iIntensity;
		endconstructor;

		export destructor()
		enddestructor;

		//Feed CVisFXManager with track data.
		export proc void Play()
			//L KLog.LogInfo("WeatherMgr","Play Track: "+m_iType.ToString()+" Intensity: "+m_iIntensity.ToString()+" WindDir: "+m_iWindDir.ToString()+""+m_xTrackLength.ToString()+" seconds");
			CVisFXManager.FXWeather.Enable(true);
			CVisFXManager.FXWeather.SetIntensity(m_iIntensity);
			if(m_iType==0)then
				CVisFXManager.FXWeather.SetIntensity(0);
			else
				CVisFXManager.FXWeather.SetType(m_iType);
			endif;
			var real fTmpDir;
			switch(m_iWindDir)
				case(0)do fTmpDir=0.0f;endcase;	//North
				case(1)do fTmpDir=315.0f;endcase;
				case(2)do fTmpDir=270.0f;endcase;	//East
				case(3)do fTmpDir=225.0f;endcase;
				case(4)do fTmpDir=180.0f;endcase;	//South
				case(5)do fTmpDir=135.0f;endcase;
				case(6)do fTmpDir=90.0f;endcase;	//West
				case(7)do fTmpDir=45.0f;endcase;
				case default do	endcase;
			endswitch;
			CVisFXManager.FXWeather.SetWindDir(fTmpDir);
			CVisFXManager.FXWeather.SetWindStrength(m_iWindStrength.ToReal());
			m_xStartTime=CTimeMgr.Get().GetTime();
		endproc;

		//Stops track.
		export proc void Stop()
			CVisFXManager.FXWeather.Enable(false);
			CVisFXManager.FXWeather.SetIntensity(0);
			CVisFXManager.FXWeather.SetType(0);
			CVisFXManager.FXWeather.SetWindStrength(0.0f);
		endproc;

		//Returns true if track play time is over
		export proc bool IsOver()
			var CGameTimeSpan	xTmp;
			var CGameTime xCur=CTimeMgr.Get().GetTime();			
			if((m_xStartTime-xCur).GetSecondsF()>(5.0f*1000.0f))then				
				m_xStartTime=xCur;
			endif;
			xTmp=xCur-m_xStartTime;
			if(xTmp>=m_xTrackLength)then
				return(true);
			else
				return(false);
			endif;
		endproc;

		//Obsolete
		export proc bool Pause(bool p_bParam)
			if(p_bParam)then

			else

			endif;
			return(true);
		endproc;

	endclass

	var bool					m_bActive;			//True if WeatherMgr is active.
	var	^CWeatherProgram		m_pxWeatherProgram;	//Active program.

	constructor()
		m_bActive=false;
	endconstructor;
	
	destructor()
		delete m_pxWeatherProgram;
	enddestructor;

	export static proc ref CWeatherMgr Get()
		if(ms_pxInst==null)then
			ms_pxInst = new CWeatherMgr;
		endif;
		return(ms_pxInst^);
	endproc;

	export static proc void Kill()
		delete ms_pxInst;
		ms_pxInst = null;
	endproc;

	//Call to initialize weather at level start
	export proc void InitWeather()
		//L KLog.LogSpam("WeatherMgr","Initializing WeatherMgr.");
		var ^CPropDB pxWeatherDB;
		var ^CLevelInfoClient pxLevelInfo=^(CGameWrap.GetClient().GetLevelInfo());
		pxWeatherDB=^(pxLevelInfo^.GetGenericData());
		if(pxWeatherDB^.GetRoot().Get("WeatherData")==null)then
			KLog.LogWarn("WeatherMgr","No weather data found in level info!");
			return();
		endif;
		m_pxWeatherProgram=new CWeatherProgram(pxWeatherDB^.GetRoot().Get("WeatherData"));
		m_pxWeatherProgram^.Start();
		SetEnabled(true);
		//L KLog.LogSpam("WeatherMgr","WeatherMgr started!");
	endproc;

	export proc bool StartSpecificProgramm(string p_sProgramPath)
		if(m_pxWeatherProgram!=null) then
			m_pxWeatherProgram^.Stop();
			delete m_pxWeatherProgram;
			m_pxWeatherProgram = null;
		endif;
		
		var CPropDB xDB;
		if(xDB.Load(p_sProgramPath)) then
			m_pxWeatherProgram = new CWeatherProgram(^(xDB.GetRoot()));
			StartWeatherProgram();
		endif;
		return m_pxWeatherProgram!=null;
	endproc;

	//Starts active weather programm.
	export proc void StartWeatherProgram()
		if(m_pxWeatherProgram!=null)then
			m_pxWeatherProgram^.Start();
		endif;
	endproc;

	//Stops active weather program.
	export proc void StopWeatherProgram()
		if(m_pxWeatherProgram!=null)then
			m_pxWeatherProgram^.Stop();
		endif;
	endproc;

	//Pauses active weather program.
	export proc void Pause(bool p_bParam)
		if(m_pxWeatherProgram!=null)then
			m_pxWeatherProgram^.Pause(p_bParam);
		endif;
	endproc;
	
	export proc void GoToNextTrack()
		if(m_pxWeatherProgram!=null) then
			m_pxWeatherProgram^.GoToNextTrack();
		endif;
	endproc;

	//Checks if track is over.
	export proc void Tick()		
		if(m_pxWeatherProgram==null) then return; endif;
		if(!m_pxWeatherProgram^.IsOver())then
			if(m_pxWeatherProgram^.GetCurrentTrack()^.IsOver())then
				m_pxWeatherProgram^.GoToNextTrack();
			endif;
		endif;
	endproc;

	//(De)activates the weather manager.
	export proc void SetEnabled(bool p_bParam)
		m_bActive=p_bParam;
	endproc;

	export proc bool GetEnabled()
		return(m_bActive);
	endproc;

endclass;

