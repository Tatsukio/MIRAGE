class CExplosionMgr

	static var ^CExplosionMgr	ms_pxInst;
	var array string			m_asGfx;
	var array ^CObj				m_apxObjs;
	var array Quat				m_aqRots;

	constructor()
	endconstructor;

	destructor()
	enddestructor;

	export static proc ref CExplosionMgr Get()
		if(ms_pxInst == null)then
			ms_pxInst = new CExplosionMgr;
		endif;
		return(ms_pxInst^);
	endproc;

	export static proc void Kill()
		delete ms_pxInst;
		ms_pxInst = null;
	endproc;

	export proc void AddProjectile(^CObj p_pxProjectile, string p_sGfxName, Quat p_qRot)
		m_apxObjs.AddEntry(p_pxProjectile);
		m_asGfx.AddEntry(p_sGfxName);
		m_aqRots.AddEntry(p_qRot);
	endproc;

	export proc string GetExplosion(^CObj p_pxProjectile, ref Quat p_rqRot)
		var int iIdx = m_apxObjs.FindEntry(p_pxProjectile);
		if(iIdx == -1)then
			return "hit_water_blunt_big";
		endif;
		var string sGfx = m_asGfx[iIdx];
		p_rqRot = m_aqRots[iIdx];

		m_apxObjs.DeleteEntry(iIdx);
		m_asGfx.DeleteEntry(iIdx);
		m_aqRots.DeleteEntry(iIdx);
		return sGfx;
	endproc;

endclass;
