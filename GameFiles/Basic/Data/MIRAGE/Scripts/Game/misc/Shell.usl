class CShell inherit CShellBase

	export proc void Exit()
		CGameWrap.Quit();
	endproc;

	export proc void Test(int p_iVal)
		CGameWrap.LogWarning("Shell","Test: " + p_iVal.ToString());
	endproc;


	proc bool GetCheatsEnabled()
		var ^CGameAttribs pxAttr = ^(CGameWrap.GetClient().GetLevelInfo().GetAttribs());
		if (pxAttr == null || pxAttr^.GetValue("cheats_enabled") != "true" ) then
			CGameWrap.LogInfo("Shell.Cheats","Cheats not activated! Ya ol'cheater!");
			return false;
		endif;
		return true;
	endproc;

	//Cheats
	export proc void GiveMeResources(string p_sType, int p_iValue)
		if (GetCheatsEnabled()) then
			var ^CAttribs pxAttr = CGameWrap.GetClient().GetPlayer().GetAttribs();
			if (pxAttr != null) then
				if (pxAttr^.ContainsKey(p_sType)) then
					pxAttr^.SetValue(p_sType,pxAttr^.GetValueInt(p_sType) + p_iValue);
					CGameWrap.LogInfo("Shell.Cheats",p_iValue.ToString() + " of " + p_sType + " added!");
				else
					CGameWrap.LogInfo("Shell.Cheats","invalid resource: " + p_sType + "\n valid variations are: food, wood, stone, iron");
				endif;
			endif;
		endif;
	endproc;
	//EndCheats

	export proc ^CObj GetSelObj()
		var ^CObjSelection pxSel = ^(CClientWrap.GetSelection());
		if (pxSel^.NumEntries() > 0) then
			var CClntHndl xObj = pxSel^.op_Index(0);
			var ^CObj pxObj = xObj.GetObj();
			if (pxObj != null) then
				CGameWrap.LogWarning("Shell","name: " + pxObj^.GetName());
				CGameWrap.LogWarning("Shell","pos: " + pxObj^.GetPos().ToString());
				CGameWrap.LogWarning("Shell","rot: " + pxObj^.GetRot().ToString());
			endif;
			return pxObj;
		endif;
		return null;
	endproc;

	export proc void AnimTest()
		var ^CObj pxObj = GetSelObj();
		if (pxObj == null) then return; endif;
		pxObj^.SetAnim("deliver",3,0);
		var CObj.CBlendAnimDesc xD;
		xD.m_sAnim = "trader";
		xD.m_iUniqueID = 123;
		xD.m_iStartFrame = 0;
		xD.m_iEndFrame = 0;
		xD.m_dwAnimMode = CObj.CBlendAnimDesc.AM_Still;
		var CGameTime xNow = CTimeMgr.Get().GetTime();
		var CObj.CBlendAnimDesc.CKey xKey;

		xKey.m_xTime = xNow;
		xKey.m_fWeight = 0.0f;
		xD.AddKey(xKey);

		xKey.m_xTime = xNow + (CGameTimeSpan.OneSecond() * 0.5f);
		xKey.m_fWeight = 1.0f;
		xD.AddKey(xKey);

		xKey.m_xTime = xNow + (CGameTimeSpan.OneSecond() * 2.0f);
		xKey.m_fWeight = 1.0f;
		xD.AddKey(xKey);

		xKey.m_xTime = xNow + (CGameTimeSpan.OneSecond() * 2.5f);
		xKey.m_fWeight = 0.0f;
		xD.AddKey(xKey);

		pxObj^.SetBlendAnim(xD);
	endproc;

	export proc string GetSelObjName()
		var ^CObj pxObj = GetSelObj();
		if (pxObj != null) then
			return pxObj^.GetName();
		endif;
		return "";
	endproc;

	export proc void PlaceObjPinkTest()
		var vec3 vPos = {395.5f,85.41f,21.52f};
		var vec3 vRot;
		var Quat qRot;
		qRot.SetXYZW(0.0f,0.0f,-0.7f,0.71f);
		qRot.ToVec3(vRot);
		var CObjList xOL;
		var string sClass = "Hu_Stone_Cottage";
		CEvt_PlaceObj.Send(sClass,vPos,vRot,xOL,false);

		vPos = {398.4f,109.5f,22.02f};
		qRot.SetXYZW(0.0f,0.0f,0.63f,0.77f);
		qRot.ToVec3(vRot);
		sClass = "Hu_Stone_Cottage";
		CEvt_PlaceObj.Send(sClass,vPos,vRot,xOL,false);

		vPos = {361.6f,86.45f,22.58f};
		qRot.SetXYZW(0.0f,0.0f,0.666f,0.7452f);
		qRot.ToVec3(vRot);
		sClass = "Hu_Stone_Cottage";
		CEvt_PlaceObj.Send(sClass,vPos,vRot,xOL,false);

		vPos = {436.9f,118.8f,21.55f};
		qRot.SetXYZW(0.0f,0.0f,0.681f,0.73f);
		qRot.ToVec3(vRot);
		sClass = "Hu_Stone_Cottage";
		CEvt_PlaceObj.Send(sClass,vPos,vRot,xOL,false);
	endproc;

