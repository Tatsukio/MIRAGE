	export proc void GenDataDump()
		var ^CLevelInfo pxLevelInfo = ^(CGameWrap.GetClient().GetLevelInfo());
		pxLevelInfo^.GetGenericData().Save("C:/GenData_Client.txt");
	endproc;

endclass;
