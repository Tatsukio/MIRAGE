<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MIRAGE_Launcher</RootNamespace>
    <AssemblyName>MIRAGE Launcher</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ApplicationIcon>Resources\mirage.ico</ApplicationIcon>
    <ApplicationManifest>MIRAGE Launcher.manifest</ApplicationManifest>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\GameFiles\Basic\Tools\MIRAGE Launcher\</OutputPath>
    <Version>3.0.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\MIRAGE.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\*.png" />
    <Resource Include="Resources\mirage.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\standard.ani" />
    <None Remove="Resources\psd\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Credits.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Settings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Locale.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Backgrounds\*.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
