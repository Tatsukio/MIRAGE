<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests without third-party libraries: "dotnet run -c Release" from this folder (works on Windows and Linux).
    The launcher's Models, Services and ViewModels and PWKiller's Core have no WPF / WinForms types, so they are
    compiled here directly; only the windows themselves are not. The same for ParaWorldStatus without its
    Discord connection (DiscordService.cs needs the DiscordRichPresence package).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MIRAGE.Tools.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\MIRAGE.Shared.csproj" />
    <ProjectReference Include="..\CfgEditor\CfgEditor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Launcher\Models\**\*.cs" Link="Linked\Launcher\Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Launcher\Services\**\*.cs" Link="Linked\Launcher\Services\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Launcher\ViewModels\**\*.cs" Link="Linked\Launcher\ViewModels\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\PWKiller\Core\**\*.cs" Link="Linked\PWKiller\Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ParaWorldStatus\ParaWorldStatus\Models\**\*.cs" Link="Linked\ParaWorldStatus\Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ParaWorldStatus\ParaWorldStatus\Services\**\*.cs" Exclude="..\ParaWorldStatus\ParaWorldStatus\Services\DiscordService.cs" Link="Linked\ParaWorldStatus\Services\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ParaWorldStatus\ParaWorldStatus\ViewModels\**\*.cs" Link="Linked\ParaWorldStatus\ViewModels\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
